{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "environment": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://sgu-hrm-project.onrender.com/api/v1" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://sgu-hrm-project.onrender.com/api/v1" }
    }
  },
  "submit": {
    "production": {}
  }
}
