PROJECT_NAME="TechZone HRM API"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
TRACKASIA_API_KEY=""
API_V1_STR="/api/v1"
# Required: provide local values in backend/.env or inject them via deployment secrets; never commit real credentials.
DATABASE_URL=""
SYNC_DATABASE_URL=""
JWT_SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# OT-FIX-01: keep disabled until the project owner approves the Vietnam business-date cutoff.
OT_REGISTRATION_POLICY_MODE="DISABLED"
# OT_REGISTRATION_POLICY_EFFECTIVE_FROM="YYYY-MM-DD"

# Mistral AI Configuration (RAG Chatbot & Embeddings)
MISTRAL_API_KEY=""
MISTRAL_CHAT_MODEL="mistral-large-latest"  # mistral-large-latest, mistral-small-latest
MISTRAL_EMBED_MODEL="mistral-embed-2312"

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="techzone-hrm-rag-chatbot"
