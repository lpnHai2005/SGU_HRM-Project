# TechZone HRM - Frontend Environment Configuration
# Copy this file to .env and update values as needed

# Backend API URL
VITE_API_URL=http://localhost:8000/api/v1

# Public, browser-visible TrackAsia key restricted to the web map domain
VITE_TRACKASIA_MAP_KEY=

# App Configuration
VITE_APP_NAME=TechZone HRM
VITE_APP_VERSION=1.0.0
